# Español translation for the pack multivariate.
# Message ids are the English source strings.

msgid ""
msgstr "Project-Id-Version: ChartLibre\nLanguage: es\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "0 chooses them by cross-validation: another component only while it cuts the prediction error by 5% or more."
msgstr "0 los elige por validación cruzada: otro componente sólo mientras corta el error de predicción en un 5% o más."

msgid "0 takes as many as the correlations have eigenvalues above 1 (see the scree plot)."
msgstr "0 toma tantos como las correlaciones tienen eigenvalues por encima de 1 (ver la trama del tornillo)."

msgid "A few directions that carry most of the variation of many columns: eigenvalues and their share, loadings, each row's scores; scree, score and loading plots."
msgstr "Algunas direcciones que llevan la mayor parte de la variación de muchas columnas: eigenvalues y su parte, cargas, puntuaciones de cada fila; scree, score and loading plots."

msgid "A few hidden factors behind many correlated columns: Maximum Likelihood or Principal Axis, rotated (Varimax, Quartimax, Equamax, Promax); loadings, communalities, each row's scores."
msgstr "Unos pocos factores ocultos detrás de muchas columnas correlativas: Máxima probabilidad o eje principal, rotado (Varimax, Quartimax, Equamax, Promax); cargas, comunas, puntuaciones de cada fila."

msgid "Actual"
msgstr "Efectivo"

msgid "Actual by predicted"
msgstr "Actual según se predijo"

msgid "Algorithm"
msgstr "Algoritm"

msgid "Biplot"
msgstr "Biplot"

