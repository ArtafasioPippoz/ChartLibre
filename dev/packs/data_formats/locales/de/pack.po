msgid "A GPX file's track, route and waypoints: latitude, longitude, elevation, time."
msgstr "Track, Route und Wegpunkte einer GPX-Datei: Breitengrad, Längengrad, Höhe, Zeit."

msgid "A MATLAB .mat file (v4 to v7): each numeric variable a dataset, or all of one length side by side."
msgstr "Eine MATLAB .mat Datei (v4 bis v7): jede numerische Variable ein Datensatz, oder alle einer Länge nebeneinander."

msgid "A NetCDF file (.nc): the variables of each set of dimensions as one table."
msgstr "Eine NetCDF-Datei (.nc): die Variablen jedes Satzes von Dimensionen als eine Tabelle."

msgid "A Prism XML project: each data table a dataset, replicates as numbered columns."
msgstr "Ein Prism XML-Projekt: Jede Datentabelle ist ein Datensatz, der als nummerierte Spalten repliziert wird."

msgid "A WAV recording: time and one column per channel."
msgstr "Eine WAV-Aufzeichnung: Zeit und eine Spalte pro Kanal."

msgid "An Apache Arrow IPC file (Feather)."
msgstr "Eine Apache Arrow IPC-Datei (Feather)."

msgid "An Apache Parquet file."
msgstr "Eine Apache Parquet Datei."

msgid "Columnar and scientific"
msgstr "Kolumnar und wissenschaftlich"

msgid "Columnar and scientific data files: Parquet, Feather/Arrow, NetCDF, MATLAB, WAV audio, GPS tracks (GPX) and GraphPad Prism."
msgstr "Säulen- und wissenschaftliche Datendateien: Parkett, Feder / Pfeil, NetCDF, MATLAB, WAV-Audio, GPS-Tracks (GPX) und GraphPad Prism."

