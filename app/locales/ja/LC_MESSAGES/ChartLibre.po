msgstr "クラスタリングアルゴリズムファミリを選択します。"

msgid "Choose the exact scipy.cluster function/workflow to use."
msgstr "使用する正確なscipy.cluster関数/ワークフローを選択します。"

msgid "Choose the kernel."
msgstr "カーネルを選択します。"

msgid "Choose the spectral or correlation estimator."
msgstr "スペクトルまたは相関推定量を選択します。"

msgid "Choose whether clusters are rendered as one point-colored series or as separate series."
msgstr "クラスターを1つの点色の系列としてレンダリングするか、別の系列としてレンダリングするかを選択します。"

msgid "Choose which numeric columns are used as clustering features."
msgstr "クラスタリング機能として使用される数値列を選択します。"

msgid "Choosing k"
msgstr "チョースk"

msgid "Circuit simulation"
msgstr "回路シミュレーション"

msgid "Closed formats (JMP, Minitab, Origin)"
msgstr "クローズドフォーマット(JMP、Minitab、オリジン)"

