msgstr "{response} による標準スコア"

msgid "Centre line"
msgstr "中心線"

msgid "Centre to edge"
msgstr "エッジへのセンター"

msgid "Choose a decomposition (a curve per component) or a manifold embedding (a 2D scatter)."
msgstr "分解（コンポーネントごとの曲線）またはマニホールド埋め込み（ 2 D散布図）を選択します。"

msgid "Choose k automatically"
msgstr "kを自動的に選択する"

