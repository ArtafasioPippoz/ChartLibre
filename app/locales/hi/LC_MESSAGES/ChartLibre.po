msgstr "{distribution} क्वांटाइल"

msgid "{factor} accounts for {percent}% of what the splits explain: the factor the tree leans on most. A share is not a test - check that it holds on validation rows."
msgstr "{factor} {percent}% के लिए खाते हैं जो विभाजन की व्याख्या करते हैं: कारक पेड़ अधिकांश पर झुकता है। एक शेयर एक परीक्षण नहीं है - जांचें कि यह सत्यापन पंक्तियों पर है।"

msgid "{factor} affects {response}"
msgstr "{factor} {response} को प्रभावित करता है"

msgid "{factor} had no effect on {response}"
msgstr "{factor} {response} पर कोई प्रभाव नहीं पड़ा"

msgid "{input}'s past added nothing to forecasting {measure}"
msgstr "{input}'s अतीत ने भविष्यवाणी करने के लिए कुछ भी नहीं जोड़ा {measure}"

msgid "{input}'s past helps forecast {measure} (Granger)"
msgstr "{input} का अतीत {measure} (Granger) भविष्यवाणी करने में मदद करता है।"

msgid "{k} by {k} bins"
msgstr "{k} by {k} bin"

msgid "{k} by {k} cells"
msgstr "{k} {k} कोशिकाओं द्वारा"

msgid "{label}: {value}"
msgstr "{label}: {value}"

msgid "{left} vs {right}"
msgstr "{left} बनाम {right}"

msgid "{level}% interval for {what}: {low} to {high}. It is the range of values these rows leave plausible; more rows would narrow it."
msgstr "{what} के लिए {level} % i अंतराल: {low} से {high} । यह उन मानों की सीमा है जो इन पंक्तियों को प्रशंसनीय छोड़ देते हैं; अधिक पंक्तियां इसे संकीर्ण कर देंगी।"

msgid "{measures} numbers, {groups} categories, {times} dates"
msgstr "{measures} संख्याएँ, {groups} श्रेणियाँ, {times} तारीखें"

msgid "{measure} again, grouped by another column"
msgstr "{measure} फिर से, दूसरे कॉलम द्वारा समूहीकृत"

msgid "{measure} and its forecast"
msgstr "{measure} और इसका पूर्वानुमान"

msgid "{measure} by number of splits"
msgstr "स्प्लिट की संख्या से {measure}"

msgid "{measure} by number of trees"
msgstr "पेड़ों की संख्या से {measure}"

msgid "{measure} by part and operator"
msgstr "पार्ट और ऑपरेटर द्वारा {measure}"

msgid "{measure} by {group}"
msgstr "{group} द्वारा {measure}"

msgid "{measure} comes back to a stable level"
msgstr "{measure} एक स्थिर स्तर पर वापस आता है"

msgid "{measure} depends on {group}"
msgstr "{measure} {group} पर निर्भर करता है"

msgid "{measure} did not depend on {group}"
msgstr "{measure} ने {group} पर निर्भर नहीं किया"

msgid "{measure} differs between them"
msgstr "{measure} उनमें से अलग है"

msgid "{measure} had no trend"
msgstr "{measure} में कोई प्रवृत्ति नहीं थी"

msgid "{measure} has a trend"
msgstr "{measure} में एक प्रवृत्ति है"

msgid "{measure} kept the same level throughout"
msgstr "{measure} ने पूरे स्तर पर एक ही स्तर को रखा"

msgid "{measure} over time"
msgstr "समय के साथ {measure}"

msgid "{measure} shifted at one point"
msgstr "{measure} एक बिंदु पर स्थानांतरित हो गया"

msgid "{measure} wandered with no level to come back to"
msgstr "{measure} वापस आने के लिए कोई स्तर के साथ भटकना"

msgid "{measure}: control chart"
msgstr "{measure}: कंट्रोल चार्ट"

msgid "{method} over {points} points: the curve keeps the slow trend and loses the quick wiggles. A feature narrower than the window is flattened along with the noise - compare it with the original before reading peaks or edges from it."
msgstr "{method} से अधिक {points} अंक: वक्र धीमी प्रवृत्ति रखता है और त्वरित विगल्स खो देता है। खिड़की की तुलना में एक विशेषता शोर के साथ चपटा हुआ है - इसे पढ़ने से पहले मूल के साथ तुलना करें चोटियों या किनारों से।"

msgid "{model} applied to {points} points: positions change, distances and angles keep what the motion keeps (a rotation or a shift keeps both, a scaling neither). The original rows are left as they were; the moved ones are in a new query."
msgstr "{model} ने {points} बिंदुओं पर लागू किया: पदों में परिवर्तन, दूरी और कोणों में क्या गति रहती है (एक रोटेशन या एक बदलाव दोनों को रहता है, न तो स्केलिंग). मूल पंक्तियां छोड़ दी जाती हैं क्योंकि वे थे; ले गए लोग एक नए क्वेरी में हैं।"

msgid "{model} · {tokens_in} tokens in, {tokens_out} out"
msgstr "{model} · {tokens_in} टोकन, {tokens_out} बाहर"

msgid "{model}: the values are changed, not the rows. Statistics on the new column describe the transformed scale - a mean of logarithms is a geometric mean, not the arithmetic one."
msgstr "{model}: मूल्यों को बदल दिया जाता है, पंक्तियों नहीं। नए स्तंभ पर सांख्यिकी परिवर्तित पैमाने का वर्णन करते हैं - logarithms का मतलब एक ज्यामितीय अर्थ है, न कि अंकगणित एक।"

msgid "{names}: needs a value."
msgstr "{names}: एक मान की जरूरत है।"

msgid "{names}: not among the parameters - add it with its value ({first}=1)."
msgstr "{names}: पैरामीटर के बीच नहीं - इसे अपने मूल्य ({first}=1) के साथ जोड़ें।"

msgid "{names}: not among the parameters. List it under Parameters - x, y and z are the coordinates."
msgstr "{names}: पैरामीटर के बीच नहीं। इसे पैरामीटर्स के तहत सूचीबद्ध करें - x, y और z निर्देशांक हैं।"

msgid "{names}: the def's parameters need their values in Parameters ({first}=1)."
msgstr "{names}: परिभाषित मापदंडों को पैरामीटर्स ({first}=1) में उनके मूल्यों की आवश्यकता होती है।"

msgid "{name} (new)"
msgstr "{name} (new)"

msgid "{name} (selection)"
msgstr "{name} (चयन)"

msgid "{name} = {value}: the nearest specification limit is {sigmas} standard deviations from the mean (3 × {name})."
msgstr "{name} = {value}: निकटतम विनिर्देश सीमा {sigmas} मानक विचलन है जिसका मतलब (3 × {name}) है।"

msgid "{name} = {value}: {meaning}. By the usual marks ({small} small, {medium} medium, {large} large) it is a {size}: how much the difference matters, where p only says whether there is one."
msgstr "{name} = {value}: {meaning}। सामान्य निशान ({small} छोटे, {medium} मध्यम, {large} बड़े) द्वारा यह एक {size} है: कितने अंतर मायने रखता है, जहां केवल ऐसा कहते हैं कि क्या एक है।"

msgid "{name} drawn with the parameters as set{values}: a curve computed, not fitted to the data."
msgstr "{name} सेट {values} के रूप में पैरामीटर के साथ तैयार: एक वक्र गणना, डेटा के लिए फिट नहीं है।"

msgid "{name} is given twice."
msgstr "{name} को दो बार दिया जाता है।"

msgid "{name} needs its value: {name}=1."
msgstr "{name} को इसके मूल्य की जरूरत है: {name}=1."

msgid "{name}: '{number}' is not a number."
msgstr "{name}: '{number}' एक नंबर नहीं है।"

msgid "{name}: defects"
msgstr "{name}: दोष"

msgid "{name}: defects per die"
msgstr "{name}: प्रति मरने के दोष"

msgid "{name}: die bins"
msgstr "{name}: मरने वाले डिब्बे"

msgid "{name}: die means"
msgstr "{name}: मरने का मतलब"

msgid "{name}: map"
msgstr "{name}: नक्शा"

msgid "{ndc} distinct categories: the system tells that many groups of parts apart - 5 or more is the usual minimum."
msgstr "{ndc} विशिष्ट श्रेणियां: सिस्टम बताता है कि भागों के कई समूह अलग-अलग हैं - 5 या अधिक सामान्य न्यूनतम है।"

msgid "{n} nodes, {dims}D"
msgstr "{n} नोड्स, {dims} D"

msgid "{personality} needs a continuous Y; {columns} is nominal - choose Nominal or Ordinal Logistic."
msgstr "{personality} को एक निरंतर Y की आवश्यकता है; {columns} नाममात्र है - नाममात्र या सामान्य लॉजिस्टिक चुनें।"

msgid "{personality} needs a nominal Y; {columns} is continuous - set its type to Nominal, or choose a least-squares personality."
msgstr "{personality} को एक नाममात्र Y की आवश्यकता है; {columns} निरंतर है - अपने प्रकार को नाममात्र पर सेट करें, या कम से कम वर्ग व्यक्तित्व चुनें।"

msgid "{points} values computed between the measured points. They follow the model through the data; they are as good as the points are close together."
msgstr "{points} मापा बिंदुओं के बीच गणना की गई मान। वे डेटा के माध्यम से मॉडल का पालन करते हैं; वे उतने अच्छे हैं जितना अंक एक साथ बंद हो जाते हैं।"

msgid "{provider} answered."
msgstr "{provider} ने उत्तर दिया।"

msgid "{provider} · {level}"
msgstr "{provider} · {level}"

msgid "{p}: if {null}, a result at least this strong would come up by chance {how_often}."
msgstr "{p}: यदि {null}, तो कम से कम यह मजबूत परिणाम संयोग से सामने आएगा {how_often} ।"

msgid "{repeats} samples were drawn (seeds {first} to {last}). When the numbers are as drawn, a test's p-values are spread evenly between 0 and 1 and about 5% of them are below 0.05. Over all the tests {rate:.1%} were. A test on discrete data, or on a few values, can be off without anything being wrong."
msgstr "{repeats} नमूने तैयार किए गए थे (बीज {first} से {last})। जब संख्याएं तैयार की जाती हैं, तो एक परीक्षण का p-value 0 से 1 के बीच समान रूप से फैल गया है और उनमें से लगभग 5% 0.05 से नीचे हैं। सभी परीक्षणों पर {rate:.1%} थे। असतत डेटा पर एक परीक्षण, या कुछ मूल्यों पर, कुछ भी गलत होने के बिना बंद किया जा सकता है।"

msgid "{response} at {cutoff} (cycles per unit of x): changes on the other side of it are taken out, those on this side pass. Near the cut-off both are only partly kept - a peak there loses some of its height."
msgstr "{cutoff} पर {response} (x की प्रति इकाई चक्र): इसके दूसरे पक्ष में परिवर्तन किए जाते हैं, जो इस तरफ होते हैं। कट-ऑफ के पास केवल आंशिक रूप से रखा जाता है - एक चोटी इसकी कुछ ऊंचाई खो देती है।"

msgid "{response} by leaf"
msgstr "पत्ते से {response}"

msgid "{role} takes {kinds} columns only: {columns}."
msgstr "{role} केवल {kinds} कॉलम लेता है: {columns} ।"

msgid "{role}: choose at least {count} column(s)."
msgstr "{role}: कम से कम {count} कॉलम चुनें।"

msgid "{rows} row(s) written to {table}."
msgstr "{rows} पंक्ति(याँ) {table} में लिखी गई।"

msgid "{rows} rows"
msgstr "{rows} पंक्तियाँ"

msgid "{rows} rows, {columns} columns"
msgstr "{rows} पंक्तियाँ, {columns} कॉलम"

msgid "{series}\nx: {x}\ny: {y}"
msgstr "{series}\nx :{x}\ny :{y}"

msgid "{series} hidden"
msgstr "{series} छिपा हुआ है"

msgid "{series} shown"
msgstr "{series} दिखाए गए"

msgid "{series} — x: {x}, y: {y}"
msgstr "{series} — x: {x}, y: {y}"

msgid "{series} — {count} points, mean x: {x}, mean y: {y}"
msgstr "{series} — {count} पॉइंट, मतलब x: {x}, मतलब y: {y}"

msgid "{series} — {percent:.1f}% of the total"
msgstr "कुल का {series} — {percent:.1f}%"

msgid "{stored} is shown {shown}"
msgstr "{stored} को {shown} दिखाया गया है"

msgid "{tables} table(s), {rows} row(s) total"
msgstr "{tables} तालिकाएँ, {rows} पंक्तियाँ कुल"

msgid "{test}, {p}: a normal distribution would rarely give values this far from its shape, so {column} is called not normal (below {alpha}, the usual line). Prefer the tests on ranks and medians to t and ANOVA, and look at the histogram for why: a long tail, two peaks."
msgstr "{test}, {p}: एक सामान्य वितरण शायद ही कभी अपने आकार से इतनी दूर मान देगा, इसलिए {column} को सामान्य नहीं कहा जाता है (सामान्य रेखा {alpha} से नीचे)। रैंक और मीडियन पर टेस्ट को T और ANOVA पर प्राथमिकता दें, और हिस्टोग्राम को देखें: एक लंबी पूंछ, दो चोटियां।"

msgid "{test}, {p}: values like these are common from a normal distribution, so nothing here says {column} is not normal. Below {alpha}, the usual line, it would say so."
msgstr "{test}, {p}: इस तरह के मान सामान्य वितरण से आम हैं, इसलिए यहां कुछ भी नहीं कहता है {column} सामान्य नहीं है। {alpha} के नीचे, सामान्य रेखा, यह ऐसा कहेगी।"

msgid "{title} {version}, licence {license}. {shown}"
msgstr ""

msgid "{what} of {element}"
msgstr "{what} {element}}"

msgid "{x} and {y} are correlated"
msgstr "{x} और {y} सहसंबंधित हैं"

msgid "{x} and {y} were not correlated"
msgstr "{x} और {y} सहसंबंधित नहीं थे।"

msgid "{x} did not change the odds of {y}"
msgstr "{x} ने {y} की बाधाओं को नहीं बदल दिया"

msgid "{y} - {x}"
msgstr "{y} - {x}"

msgid "{y} against {x}"
msgstr "{y} {x} के विरुद्ध"

msgid "{y} by {x}"
msgstr "{x} द्वारा {y}"

msgid "{y} depends on {x}"
msgstr "{y} {x} पर निर्भर करता है"

msgid "{y} did not depend on {x}"
msgstr "{y} ने {x} पर निर्भर नहीं किया"

msgid "▲ number · ● category · ◐ ordered category · ◷ date"
msgstr "▲ संख्या · ● श्रेणी · ◐ ऑर्डर की गई श्रेणी · ◷ तारीख"

msgid "The dates' format, in strftime codes: %d day, %m month, %Y year, %H:%M:%S time, %b month name."
msgstr "तारीखों का फ़ॉर्मेट, स्ट्रॉफ़्टाइम कोड में: %d दिन, %m महीना, %Y साल, % H :% M:%S समय, %b महीने का नाम।"

msgid "strftime codes: %d day, %m month, %Y year, %H:%M:%S time, %b month name."
msgstr "strftime कोड: %d दिन, %m महीना, %Y वर्ष, %H:%M:%S समय, %b महीने का नाम।"

msgid "A pack switched on or off is applied the next time the app starts."
msgstr "चालू या बंद किया गया पैक अगली बार ऐप के शुरू होने पर लागू किया जाता है।"

msgid "Apple Foundation Models"
msgstr "एप्पल फाउंडेशन मॉडल"

msgid "Delete a pack you added. A pack that came with ChartLibre can only be switched off."
msgstr "आपके द्वारा जोड़ा गया पैक डिलीट करें। ChartLibre के साथ आया पैक सिर्फ़ बंद किया जा सकता है।"

msgid "Download and install, into ChartLibre's own Python, the libraries the chosen pack needs. It needs the Internet."
msgstr "चुने गए पैक को जिन लाइब्रेरी की ज़रूरत है, उन्हें डाउनलोड करें और ChartLibre के अपने Python में इंस्टॉल करें। इसके लिए इंटरनेट की ज़रूरत है।"

msgid "GitHub Copilot"
msgstr "GitHub Copilot"

msgid "GitHub Copilot's models through GitHub Models, with a GitHub token - or any OpenAI-compatible chat endpoint."
msgstr "GitHub मॉडल के माध्यम से GitHub Copilot के मॉडल, एक GitHub टोकन - या किसी भी OpenAI-compatible चैट समापन बिंदु के साथ।"

msgid "Install the libraries"
msgstr "लाइब्रेरी इंस्टॉल करें"

msgid "Installed: {names}."
msgstr "इंस्टॉल किया गया: {names}।"

msgid "Installing {names}…"
msgstr "{names} इंस्टॉल किया जा रहा है…"

msgid "Open folder"
msgstr "फ़ोल्डर खोलें"

msgid "The model built into macOS (Apple Intelligence): no key, and nothing leaves the computer."
msgstr "मॉडल मैकओएस (ऐप्पल इंटेलिजेंस) में बनाया गया है: कोई कुंजी नहीं है, और कुछ भी कंप्यूटर को छोड़ देता है।"

msgid "{names} could not be installed. {why}"
msgstr "{names} इंस्टॉल नहीं किया जा सका। {why}"

msgid "A GPX file's track, route and waypoints: latitude, longitude, elevation, time."
msgstr "एक GPX फ़ाइल का ट्रैक, मार्ग और वेपॉइंट: अक्षांश, देशांतर, ऊंचाई, समय।"

msgid "A LabVIEW Write To Measurement File text file: each segment a dataset."
msgstr "एक LabVIEW राइट टू मेजरमेंट फ़ाइल टेक्स्ट फ़ाइल: प्रत्येक सेगमेंट एक डेटासेट है।"

msgid "A MATLAB .mat file (v4 to v7): each numeric variable a dataset, or all of one length side by side."
msgstr "एक MATLAB .mat फ़ाइल (v4 से v7): प्रत्येक संख्यात्मक चर एक डेटासेट, या एक साथ एक लंबाई के सभी।"

msgid "A Prism XML project: each data table a dataset, replicates as numbered columns."
msgstr "एक प्रिज्म XML प्रोजेक्ट: प्रत्येक डेटा टेबल एक डेटासेट है, जो क्रमांकित कॉलम के रूप में दोहराता है।"

msgid "A SAS dataset (.sas7bdat) or transport file (.xpt)."
msgstr "एक SAS डेटासेट (.sas7bdat) या ट्रांसपोर्ट फ़ाइल (.xpt)."

msgid "A Stata dataset (.dta), value labels as categories."
msgstr "एक STATA डेटासेट (.dta), श्रेणियों के रूप में मूल्य लेबल।"

msgid "A VNA's .sNp file: frequency and each S (or Y, Z) parameter as its file gives it."
msgstr "एक VNA की .sNp फ़ाइल: आवृत्ति और प्रत्येक S (या Y, Z) पैरामीटर जैसा कि इसकी फ़ाइल इसे देती है।"

msgid "A WAV recording: time and one column per channel."
msgstr "एक WAV रिकॉर्डिंग: प्रति चैनल समय और एक कॉलम।"

msgid "A circuit simulation's waveforms: one column per trace; each plot a dataset, .step runs numbered."
