msgstr "Z = f(x, y) के लिए y रेंज का अंत।"

msgid "Engine"
msgstr "इंजन"

msgid "Enter a table name and at least one column."
msgstr "तालिका का नाम और कम से कम एक कॉलम दर्ज करें।"

msgid "Enter a table name."
msgstr "तालिका का नाम दर्ज करें।"

msgid "Epsilon"
msgstr "एप्सिलॉन"

msgid "Equal counts (quantiles)"
msgstr "बराबर संख्या (क्वांटाइल)"

msgid "Equal to..."
msgstr "के बराबर..."

