msgstr "X और स्तंभ में समान लंबाई होनी चाहिए।"

msgid "X axis: click to edit it"
msgstr "X अक्ष: इसे संपादित करने के लिए क्लिक करें"

msgid "X from"
msgstr "X से"

msgid "X points"
msgstr "एक्स अंक"

msgid "X range"
msgstr "X श्रेणी"

msgid "X spacing"
msgstr "एक्स स्पेसिंग"

msgid "X to"
msgstr "X to"

