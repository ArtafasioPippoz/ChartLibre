msgstr "SQL लिखें"

msgid "Write a column's name"
msgstr "किसी कॉलम का नाम लिखें"

msgid "Write a letter on each panel of a multi-axis figure."
msgstr "बहु - अक्ष आकृति के प्रत्येक पैनल पर एक पत्र लिखें।"

msgid "Write a table's name"
