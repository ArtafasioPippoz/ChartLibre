msgstr "अज्ञात वितरण '{key}' उपलब्ध: {names}"

msgid "Unknown kind of noise: {kind}"
msgstr "अज्ञात प्रकार का शोर: {kind}"

msgid "Unknown layout '{layout}'. Available: {names}"
msgstr "Unknown लेआउट '{layout}' उपलब्ध: {names}"

msgid "Unknown way to give the amount of noise: {mode}"
msgstr "शोर की मात्रा देने का अज्ञात तरीका: {mode}"

