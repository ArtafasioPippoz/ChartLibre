msgstr "प्रभाव परीक्षण"

msgid "Effects"
msgstr "प्रभाव"

msgid "Effects Pareto ({measure})"
msgstr "इफेक्ट्स पेरेटो ({measure})"

msgid "Effects, drawn in this order"
msgstr "प्रभाव, इस क्रम में खींचा"

msgid "Eigenvalue"
msgstr "आइजन - वैल्यू"

msgid "Eigenvalues"
msgstr "आइजनवैल्यू"

msgid "Eigenvectors"
msgstr "आइजनवेक्टर"

msgid "Elliptic"
msgstr "दीर्घवृत्त"

msgid "Emphasis"
msgstr "ज़ोर"

msgid "Empirical distribution"
msgstr "Empirical वितरण"

msgid "Empty or blank text is missing"
msgstr "खाली या खाली टेक्स्ट मौजूद नहीं है"

msgid "Empty or not a number"
msgstr "खाली है या कोई संख्या नहीं है"

